msgid "Keyword links"
msgstr "Trefwoordlinks"

msgid "You are not allowed to manage keyword links."
msgstr "Je mag geen trefwoordlinks beheren."

msgid "While editing a post or page, every phrase below is turned into a link to its page the first time it appears in a paragraph, heading or list item."
msgstr "Tijdens het bewerken van een bericht of pagina wordt elke zin hieronder een link naar de bijbehorende pagina, de eerste keer dat hij in een alinea, kop of lijstitem voorkomt."

msgid "Edit rule"
msgstr "Regel bewerken"

msgid "Add rule"
msgstr "Regel toevoegen"

msgid "Keywords or phrases"
msgstr "Trefwoorden of zinnen"

msgid "One per line, or separated by commas. Matching ignores case and only matches whole words."
msgstr "Eén per regel, of gescheiden door komma's. Hoofdletters maken niet uit en alleen hele woorden tellen."

msgid "Links to page"
msgstr "Linkt naar pagina"

msgid "— Select a page —"
msgstr "— Kies een pagina —"

msgid "Update rule"
msgstr "Regel opslaan"

msgid "Cancel"
msgstr "Annuleren"

msgid "Rules"
msgstr "Regels"

msgid "Actions"
msgstr "Acties"

msgid "No rules yet."
msgstr "Nog geen regels."

msgid "not linked until published"
msgstr "pas gelinkt na publicatie"

msgid "Page no longer exists"
msgstr "Pagina bestaat niet meer"

msgid "Edit"
msgstr "Bewerken"

msgid "Delete"
msgstr "Verwijderen"

msgid "Rule saved."
msgstr "Regel opgeslagen."

msgid "Rule deleted."
msgstr "Regel verwijderd."

msgid "Enter at least one phrase and choose a page."
msgstr "Vul minstens één zin in en kies een pagina."
